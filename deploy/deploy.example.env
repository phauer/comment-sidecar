# Copy to deploy/deploy.env (gitignored) and fill in your values.
# ssh target. An alias from ~/.ssh/config works (user@host too).
SSH_TARGET=my-webspace
# directory on the server that holds comment-sidecar.php. no trailing slash.
REMOTE_DIR=/path/to/comment-sidecar
# base url of the deployed backend. with trailing slash.
BASE_URL=https://comments.example.com/
# site keys (keys of SITES in config.php) to smoke test after the deploy. space separated.
SMOKE_TEST_SITES="example.com example.de"
# optional: copy the css into your site's theme after a successful deploy
#CSS_COPY_TO=/path/to/your-site/static/css/comment-sidecar-basic.css
